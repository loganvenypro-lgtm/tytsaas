PORT=4000
# The API listens on 127.0.0.1 (only Next reaches it); 0.0.0.0 opens it to the network
# HOST=127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/tytsaas
# generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
# Header with the visitor IP for the auth rate limits (default x-forwarded-for, which
# Next passes on as the client sent it: the proxy in front must overwrite it).
# Behind Cloudflare: cf-connecting-ip
# CLIENT_IP_HEADER=

# OAuth sign-in: redirect URI is <BETTER_AUTH_URL>/api/auth/callback/<google|discord>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Auto-join on Discord sign-in: bot token (Bot tab) + server ID; the bot must be in the server
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Local dev-only test account (created through /signup on localhost)
TEST_USER_EMAIL=i18n-test@example.test
TEST_USER_PASSWORD=dev-Zoy3z_zwdjUz

# YouTube worker (npm run worker). Every setting is listed with its default in worker/config.js.
YOUTUBE_API_KEY=
# YOUTUBE_DAILY_QUOTA=10000
# SCAN_QUOTA_SHARE=0.9
# SCAN_INTERVAL_MINUTES=30
# DISCOVERY_INTERVAL_HOURS=6
# DISCOVERY_REGIONS=US,GB,CA,FR,DE,ES,BR,IN
# DISCOVERY_QUERIES=extra search,another one
# SCAN_RSS_HOT_MINUTES=60
# TRENDING_INTERVAL_HOURS=24
# MONETIZATION_INTERVAL_HOURS=6

# Discord reports from the worker: new outliers each tick, a daily data report
# (DISCORD_DAILY_HOUR, Paris time) and alerts (failures, RSS throttling, quota).
DISCORD_WEBHOOK_URL=
# DISCORD_ALERTS_WEBHOOK_URL=   (alerts elsewhere; defaults to DISCORD_WEBHOOK_URL)
# DISCORD_MIN_SCORE=60
# DISCORD_DAILY_HOUR=9
# Weekly recap built for every user on Monday at this hour (Paris time)
# WEEKLY_DIGEST_HOUR=8
# Transactional emails (welcome, new sign-in, password reset, team invitations) via Resend.
# EMAIL_FROM must use a domain verified in Resend; onboarding@resend.dev only reaches your own address.
RESEND_API_KEY=
# EMAIL_FROM=Returbe <noreply@example.com>
# EMAIL_REPLY_TO=

# Onboarding answers posted to Discord when a user finishes or skips the onboarding
DISCORD_ONBOARDING_WEBHOOK_URL=
# Every sign-in / sign-up posted to Discord: new or returning account, IP, device, where they came from
DISCORD_SIGNIN_WEBHOOK_URL=

# AI help in folder ideation notes (complete / fix a note), on Groq. Without it the buttons answer "not configured".
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# PostHog: NEXT_PUBLIC_POSTHOG_KEY goes in frontend/.env.local (project API key, phc_…).
# POSTHOG_PROJECT_URL is the link on the admin overview.
# POSTHOG_PROJECT_URL=https://us.posthog.com/project/677562
