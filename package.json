{
  "name": "tytsaas",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "node --env-file-if-exists=.env --test \"test/*.test.js\"",
    "start": "node --env-file=.env server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "import:outlr": "node --env-file=.env scripts/import-outlr.js",
    "import:outlr-json": "node --env-file=.env scripts/import-outlr-json.js",
    "worker": "node --env-file=.env worker/index.js",
    "worker:once": "node --env-file=.env worker/index.js --once",
    "classify:all": "node --env-file=.env scripts/classify-all.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --only tytsaas-worker",
    "pm2:start:all": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs tytsaas-worker",
    "pm2:status": "pm2 status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "^1.7.12",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pm2": "^6.0.14"
  }
}
